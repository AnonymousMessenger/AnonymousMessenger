<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dx_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER - Impossible to miss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_baseline_person_24"
                app:tint="@color/dx_white"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_1_choose_your_nickname"
                android:textColor="@color/green_tor"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/what_should_people_call_you"
                android:textColor="@color/dx_white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_name_will_be_visible_to_other_users_you_can_change_it_later"
                android:textColor="@color/dx_white"
                android:textSize="16sp"
                android:alpha="0.8"
                android:gravity="center"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- NICKNAME ENTRY CARD - With clear visual feedback -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/dx_night_940"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="24dp"
            android:id="@+id/nickname_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Visual indicator that this is where you type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/dx_white"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type_your_nickname_here"
                        android:textColor="@color/dx_white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- The actual input field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/txt_layout_caption"
                    style="@style/TextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_highlight"
                    android:hint="@string/enter_nickname">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/txt_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="flagNoPersonalizedLearning|actionDone"
                        android:minHeight="64dp"
                        android:singleLine="true"
                        android:textColor="@color/dx_white"
                        android:textColorHint="@color/dx_white"
                        android:textSize="18sp"
                        android:padding="16dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Help section - More prominent -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="24dp">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_nickname_help"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/get_help_with_choosing_a_nickname"
                        android:src="@drawable/ic_baseline_help_24"
                        app:backgroundTint="@color/dx_alert"
                        app:fabSize="mini"
                        app:tint="@color/dx_white" />

                    <TextView
                        android:id="@+id/txt_error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/tap_for_help"
                        android:textColor="@color/dx_white"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PROGRESS INDICATOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="24dp">

            <View
                android:layout_width="24dp"
                android:layout_height="4dp"
                android:background="@color/green_tor"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="4dp"
                android:background="@color/dx_night_700"
                android:layout_marginEnd="4dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="4dp"
                android:background="@color/dx_night_700"/>
        </LinearLayout>

        <!-- NEXT BUTTON - With clear state indication -->
        <Button
            android:id="@+id/next"
            style="@style/DXButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_txt"
            android:enabled="false"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/dx_night_700"
            android:textAllCaps="true"/>

<!--        <TextView-->
<!--            android:id="@+id/btn_skip"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="I already have an account →"-->
<!--            android:textColor="@color/dx_white"-->
<!--            android:textSize="14sp"-->
<!--            android:gravity="center"-->
<!--            android:padding="16dp"-->
<!--            android:alpha="0.7"-->
<!--            android:clickable="true"-->
<!--            android:focusable="true"/>-->
    </LinearLayout>
</ScrollView>